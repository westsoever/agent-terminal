#!/usr/bin/env bash
# agent-terminal-proposals - review and decide what the learner proposes (Phase 6 spec section 6).
#   agent-terminal-proposals list [--all]          open proposals: kind id: first sentence (sessions/days); --all adds decided ones
#   agent-terminal-proposals show <id>             the whole file, the patch coloured
#   agent-terminal-proposals diff <id>             a rule: the patch applied to a copy of the live target, as a diff
#   agent-terminal-proposals approve <id>          only a person at a terminal, never a Claude Code session (see below). It
#                                         shows what will happen, then shows a short random code and reads it back
#                                         from /dev/tty (typed once; anything else cancels):
#                                           rule: shows the change, then patches the target (the old
#                                                 version is kept in archive/<id>.target-before)
#                                           skill: writes nothing into ~/.claude/skills; prints the prompt that starts
#                                                 a skill-creator session
#                                           lesson: appends it to $AGENT_HOME/profile/lessons.jsonl
#                                           blindspot, prune: recorded, nothing to apply
#   agent-terminal-proposals reject <id> [reason]  adds the fingerprint (and the reason) to rejected.txt: never proposed again
#   agent-terminal-proposals snooze <id> <days>    hidden until then; the learner may propose it again after that date
# Every decision sets the file's status, moves it to archive/ and emits a `proposal` event {id, action}.
# Only a person approves (spec 6.4), in three layers here:
#   1. refused when a Claude Code session started it: one of SESSION_VARS is set, or a process up the parent chain is
#      claude (ps comm or argv[0] named claude, or a claude-code / claude/versions path). The walk catches a session
#      that unset the variables;
#   2. stdin and stdout must be a TTY;
#   3. a random code is shown and must be typed back on /dev/tty. A pty wrapper (script -q /dev/null) fed a blind
#      answer cannot know it, and anything typed ahead is flushed before the question.
# guard.sh adds a cheap fourth layer: a session may call agent-terminal-proposals only directly, as list, show, diff, reject,
# snooze or help. Residual risk: a session that detaches a process from its own tree (double fork, launchd, a tmux
# server it started), clears the variables, then reads the code off the screen and types it back. That is deliberate
# circumvention rather than an over-eager session, and such a session could as well edit the target by hand.
# Tests only: AGENT_TERMINAL_TEST=1 with AGENT_TERMINAL_TEST_ANCESTRY_STOP=<pid> ends the parent walk at that pid (the suite itself may run
# inside a session). It is honoured only when AGENT_HOME, HOME and a rule's target all resolve inside a
# /tmp/agent-terminal-tests.* sandbox (tests/run.sh makes it), so it can never approve a real proposal or change a real file;
# with AGENT_TERMINAL_TEST=1 anywhere else approve exits 3.
# Colour: when stdout is a terminal, unless NO_COLOR is set; AGENT_TERMINAL_COLOR=always|never overrides.
# Env: AGENT_HOME (default ~/.agent; proposals live in $AGENT_HOME/proposals) HOME (a target's ~)
set -euo pipefail
SELF=$(perl -MCwd=realpath -e 'print realpath($ARGV[0])' "${BASH_SOURCE[0]}")
SELF_DIR=${SELF%/*}
# shellcheck source=lib.sh
. "$SELF_DIR/lib.sh"

usage() { sed -n '2,/^# Env:/p' "$SELF" | sed 's/^# \{0,1\}//'; }
die() { echo "agent-terminal-proposals: $1" >&2; exit "${2:-1}"; }

case "${AGENT_TERMINAL_COLOR:-auto}" in
  always) COLOR=1 ;;
  never) COLOR=0 ;;
  *) if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then COLOR=1; else COLOR=0; fi ;;
esac
paint() { # stdin -> stdout; diff lines coloured (only the patch section when $1 = file)
  if [ "$COLOR" -ne 1 ]; then cat; return 0; fi
  awk -v whole="${1:-diff}" '
    BEGIN { R = "\033[31m"; G = "\033[32m"; C = "\033[36m"; B = "\033[1m"; N = "\033[0m"; on = (whole == "diff") }
    whole == "file" && /^## / { on = ($0 == "## patch"); print B $0 N; next }
    on && /^(\+\+\+|---) / { print B $0 N; next }
    on && /^\+/ { print G $0 N; next }
    on && /^-/ { print R $0 N; next }
    on && /^@@/ { print C $0 N; next }
    { print }'
}

PROOT="$AGENT_HOME/proposals"
root_or_none() { # [decide] -> ROOT, the canonical root. With none yet: read-only commands say so and exit 0 (they
  # never make it), a decision fails
  if [ -L "$PROOT" ]; then die "$PROOT is a symlink; refusing to use it" 3; fi
  if [ ! -d "$PROOT" ]; then
    [ "${1:-}" != decide ] || die "no open proposal ${ID:-} (there is no $PROOT yet)"
    echo "no proposals yet ($PROOT does not exist)"; exit 0
  fi
  ROOT=$(proposals_root) || exit 3
}

check_id() { # id -> ID (no .md), or exit 2
  ID=${1%.md}
  [[ "$ID" =~ ^(rule|skill|blindspot|prune|lesson)-[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "'$1' is not a proposal id (kind-slug, as 'list' shows it)" 2
}
open_file() { # ID -> FILE at the top of the root, or exit 1
  FILE="$ROOT/$ID.md"
  if [ -L "$FILE" ] || [ ! -f "$FILE" ]; then
    if ls "$ROOT/archive/$ID".*md >/dev/null 2>&1 || [ -f "$ROOT/archive/$ID.md" ]; then
      die "$ID was already decided (it is in $ROOT/archive)"
    fi
    die "no open proposal $ID (see: agent-terminal-proposals list)"
  fi
}
any_file() { # ID -> FILE: the open one, else the newest archived copy
  FILE="$ROOT/$ID.md"
  if [ -f "$FILE" ] && [ ! -L "$FILE" ]; then return 0; fi
  FILE=$(ls -t "$ROOT/archive/$ID.md" "$ROOT/archive/$ID".[0-9]*.md 2>/dev/null | head -1 || true)
  [ -n "$FILE" ] && [ ! -L "$FILE" ] || die "no proposal $ID (see: agent-terminal-proposals list --all)"
}

first_sentence() { # file -> the first sentence of ## proposal, on one line, at most 160 characters
  proposal_section "$1" proposal | tr '\n' ' ' | perl -ne 's/\s+/ /g; s/^ //; s/(.*?[.!?])(\s.*|$)/$1/; print substr($_, 0, 160)'
}
is_open() { # file -> true for status open, or a snooze whose date has passed
  local st today
  st=$(proposal_get "$1" status); today=$(date +%Y-%m-%d)
  case "$st" in
    open) return 0 ;;
    snoozed:*) [[ ! "${st#snoozed:}" > "$today" ]] ;;
    *) return 1 ;;
  esac
}
line_of() { # file -> "kind id: first sentence (n sessions/m days)"
  printf '%s %s: %s (%s sessions/%s days)' "$(proposal_get "$1" kind)" "$(proposal_get "$1" id)" "$(first_sentence "$1")" \
    "$(proposal_get "$1" sessions)" "$(proposal_get "$1" days)"
}

open_rows() { # the open proposals at the top of ROOT, most sessions first, as list lines
  local f
  for f in "$ROOT"/*.md; do
    [ -f "$f" ] && [ ! -L "$f" ] || continue
    case "${f##*/}" in report-*) continue ;; esac
    is_open "$f" || continue
    printf '%s\t%s\t%s\n' "$(proposal_get "$f" sessions)" "${f##*/}" "$(line_of "$f")"
  done | sort -t $'\t' -k1,1rn -k2,2 | cut -f3
}

# expand_target TARGET -> REAL: the absolute, symlink-resolved file a rule changes (exit 1 when it cannot be used)
expand_target() {
  local t=$1
  # shellcheck disable=SC2088 # a literal ~ in the header
  case "$t" in "~") t=$HOME ;; "~/"*) t="$HOME/${t#"~/"}" ;; esac
  case "$t" in /*) ;; *) die "target '$1' is not an absolute or ~ path; apply it by hand" ;; esac
  [ -f "$t" ] || die "target $t does not exist (or is not a file)"
  REAL=$(perl -MCwd=realpath -e 'print realpath($ARGV[0])' "$t")
  [ -f "$REAL" ] || die "target $t does not resolve to a file"
}
# patched_copy FILE -> NEW (a temp file holding the target after the patch) and REAL, or exit 1. The patch must
# change exactly one file; it is applied to the target named in the header, whatever names the diff uses.
patched_copy() {
  local f=$1 n
  [ "$(proposal_get "$f" kind)" = rule ] || die "only rule proposals have a patch (this is a $(proposal_get "$f" kind)); use: agent-terminal-proposals show $ID" 2
  expand_target "$(proposal_get "$f" target)"
  TMPD=$(mktemp -d "${TMPDIR:-/tmp}/agent-terminal-proposals.XXXXXX"); trap 'rm -rf "$TMPD"' EXIT
  proposal_patch "$f" >"$TMPD/p.diff"
  n=$(grep -c '^+++ ' "$TMPD/p.diff" || true)
  [ "$n" -eq 1 ] || die "the patch must change exactly one file (it has $n '+++' headers); apply it by hand"
  NEW="$TMPD/new"
  if ! patch -s -N -p1 --no-backup-if-mismatch -r "$TMPD/rej" -o "$NEW" "$REAL" <"$TMPD/p.diff" >"$TMPD/patch.out" 2>&1; then
    cat "$TMPD/patch.out" >&2
    die "the patch does not apply to $REAL as it is now (it may have changed since the proposal); reject it or apply it by hand"
  fi
}
show_diff() { # label -> the change REAL -> NEW as a unified diff
  diff -u --label "$1 (now)" --label "$1 (after approve)" "$REAL" "$NEW" | paint || true
}

# ---------- who is asking: only a person approves (spec 6.4; the layers are described at the top) ----------
# What a Claude Code Bash tool sets (seen in a real session, Claude Code 2.1.301, 2026-10-17): CLAUDECODE=1,
# CLAUDE_CODE_ENTRYPOINT=cli, CLAUDE_CODE_SESSION_ID, CLAUDE_CODE_EXECPATH, CLAUDE_CODE_CHILD_SESSION, CLAUDE_PID and
# AI_AGENT=claude-code_<version>_agent; IDE integrations add CLAUDE_CODE_SSE_PORT. Not every CLAUDE_CODE_* name: people
# export CLAUDE_CODE_USE_BEDROCK and the like in their own shell. AGENT_TERMINAL_LEARNER is the learner job (guard.sh).
# not CLAUDE_CODE_SSE_PORT: the VS Code extension sets it in every integrated terminal, so it would lock the owner
# out; a session started from VS Code is still caught by the other variables and the parent-process walk
SESSION_VARS="CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SESSION_ID CLAUDE_CODE_EXECPATH CLAUDE_CODE_CHILD_SESSION CLAUDE_PID AI_AGENT AGENT_TERMINAL_LEARNER"
TEST_MODE=0
under_sandbox() { # path -> 0 when it resolves inside a /tmp/agent-terminal-tests.* folder (tests/run.sh's sandbox)
  local r
  r=$(perl -MCwd=realpath -e 'my $r = realpath($ARGV[0]); print defined $r ? $r : ""' "$1" 2>/dev/null) || return 1
  case "$r" in /private/tmp/agent-terminal-tests.?*/?*|/tmp/agent-terminal-tests.?*/?*) return 0 ;; esac
  return 1
}
test_mode() { # AGENT_TERMINAL_TEST=1 -> TEST_MODE=1 when AGENT_HOME and HOME are in the sandbox; anywhere else exit 3
  [ "${AGENT_TERMINAL_TEST:-}" = 1 ] || return 0
  if ! under_sandbox "$AGENT_HOME" || ! under_sandbox "$HOME"; then
    die "AGENT_TERMINAL_TEST is honoured only inside the test sandbox (/tmp/agent-terminal-tests.*); not approving" 3
  fi
  TEST_MODE=1
}
claude_ancestor() { # -> prints "pid name" of the nearest claude process up the parent chain (exit 0), exit 1 when
  # there is none, exit 2 when the process table cannot be read. One ps call per column set, then a walk in awk.
  local stop=1 tab args
  if [ "$TEST_MODE" -eq 1 ] && [[ "${AGENT_TERMINAL_TEST_ANCESTRY_STOP:-}" =~ ^[0-9]+$ ]]; then stop=$AGENT_TERMINAL_TEST_ANCESTRY_STOP; fi
  # absolute paths: a fake ps or awk first on PATH must not be able to hide a claude ancestor
  tab=$(/bin/ps -axww -o pid= -o ppid= -o comm= 2>/dev/null) && [ -n "$tab" ] || return 2
  args=$(/bin/ps -axww -o pid= -o args= 2>/dev/null) && [ -n "$args" ] || return 2
  { printf '%s\n' "$tab"; echo "--args--"; printf '%s\n' "$args"; } | /usr/bin/awk -v start="$PPID" -v stop="$stop" '
    function isclaude(p,   c, a, w, n, i) {   # comm, or the first or second word of args (node .../bin/claude)
      c = tolower(comm[p]); sub(/.*\//, "", c)
      if (c == "claude") return 1
      a = tolower(args[p]); n = split(a, w, " ")
      for (i = 1; i <= n && i <= 2; i++) { sub(/.*\//, "", w[i]); if (w[i] == "claude") return 1 }
      return (a ~ /claude-code\/cli/ || a ~ /@anthropic-ai\/claude-code/ || a ~ /\/claude\/versions\//)
    }
    $0 == "--args--" { part = 2; next }
    part != 2 { p = $1; pp[p] = $2; $1 = ""; $2 = ""; sub(/^ +/, ""); comm[p] = $0; next }
    { p = $1; $1 = ""; sub(/^ +/, ""); args[p] = $0 }
    END {
      p = start; n = 0
      while (p > 1 && p != stop && n < 200) {
        if (isclaude(p)) { print p " " comm[p]; exit 0 }
        if (!(p in pp)) break
        p = pp[p]; n++
      }
      exit 1
    }'
}
session_check() { # id -> exits unless this was started by a person, not by a Claude Code session (layer 1)
  local v hit rc=0 how="Open your own terminal window (not Claude Code's ! prompt) and run: agent-terminal-proposals approve ${1:-<id>}"
  for v in $SESSION_VARS; do
    if [ -n "${!v:-}" ]; then die "approve is for the person at a terminal, not a Claude Code session ($v is set). $how"; fi
  done
  hit=$(claude_ancestor) || rc=$?
  case "$rc" in
    0) die "approve is for the person at a terminal, not a Claude Code session (it runs under claude, process $hit). $how" ;;
    1) ;;
    *) die "approve cannot read the process table to check who is asking; not approving" ;;
  esac
}
confirm() { # question -> 0 when the person typed the shown code back on the terminal (layer 3). The answer is read
  # from /dev/tty, not stdin, and whatever was typed or piped ahead is flushed first, so only someone who read the
  # code can answer.
  local code ans=""
  ( : <>/dev/tty ) 2>/dev/null || die "cannot open /dev/tty to ask for the confirmation code; run it in a terminal"
  exec 3<>/dev/tty
  code=$(od -An -N4 -tu1 /dev/urandom | awk '{ s = "abcdefghjkmnpqrstuvwxyz23456789"; for (i = 1; i <= NF; i++) printf "%s", substr(s, $i % 31 + 1, 1) }')
  [ "${#code}" -eq 4 ] || die "could not make a confirmation code"
  perl -MPOSIX=tcflush,TCIFLUSH -e 'tcflush(0, TCIFLUSH)' <&3 2>/dev/null || true
  printf '\n%s Type %s to confirm (anything else cancels): ' "$1" "$code" >&3
  IFS= read -r -t 600 ans <&3 || true
  exec 3<&-
  ans=$(printf '%s' "$ans" | tr -d '[:space:]' | tr 'A-Z' 'a-z')
  [ "$ans" = "$code" ]
}

# decide FILE STATUS ACTION: set the status, move the file to archive/ (another copy with the same id gets a time
# suffix), emit the proposal event. Prints the archived path.
decide() {
  local f=$1 st=$2 action=$3 arch dest tmp
  arch=$(proposal_safe_path "archive/$ID.md") || die "cannot use $ROOT/archive" 3
  if [ -e "$arch" ]; then   # decided before (a snooze ran out and the learner proposed it again)
    arch=$(proposal_safe_path "archive/$ID.$(date -u +%Y%m%dT%H%M%SZ).md") || die "cannot use $ROOT/archive" 3
  fi
  dest=$arch; tmp="${dest%/*}/.${dest##*/}.tmp.$$"
  awk -v st="$st" 'h == 0 && /^status: / { print "status: " st; next } /^$/ { h = 1 } { print }' "$f" >"$tmp" \
    && chmod 600 "$tmp" && mv -f "$tmp" "$dest" && rm -f "$f" || { rm -f "$tmp"; die "could not move $f to $dest"; }
  SID=""; NAME="agent-terminal-proposals"; CWD=$PWD
  ev proposal "$(jq -nc --arg id "$ID" --arg a "$action" '{id: $id, action: $a}')"
  DECIDED=$dest
}

cmd=${1:-}; [ $# -eq 0 ] || shift
case "$cmd" in
  list)
    all=0; [ "${1:-}" != --all ] || all=1
    root_or_none
    rows=$(open_rows)
    if [ -n "$rows" ]; then printf '%s\n' "$rows" | sed 's/^/  /'; else echo "  (no open proposals)"; fi
    if [ "$all" -eq 1 ]; then
      echo "decided:"
      found=0
      for f in "$ROOT"/archive/*.md; do
        [ -f "$f" ] && [ ! -L "$f" ] || continue
        printf '  [%s] %s\n' "$(proposal_get "$f" status)" "$(line_of "$f")"; found=1
      done
      [ "$found" -eq 1 ] || echo "  (none)"
    fi
    rep=$(ls "$ROOT"/report-*.md 2>/dev/null | LC_ALL=C sort | tail -1 || true)
    [ -z "$rep" ] || echo "latest weekly report: $rep"
    exit 0 ;;

  show)
    [ $# -ge 1 ] || die "usage: agent-terminal-proposals show <id>" 64
    check_id "$1"; root_or_none; any_file
    paint file <"$FILE"
    exit 0 ;;

  diff)
    [ $# -ge 1 ] || die "usage: agent-terminal-proposals diff <id>" 64
    check_id "$1"; root_or_none; any_file
    patched_copy "$FILE"
    show_diff "$(proposal_get "$FILE" target)"
    exit 0 ;;

  approve)
    # first, before anything is read: only a person at a terminal approves (spec 6.4). Not a session (layer 1), and a
    # session's Bash tool has no TTY (layer 2); the code typed back (layer 3) comes once the person has seen the change.
    test_mode
    session_check "${1:-}"
    if [ ! -t 0 ] || [ ! -t 1 ]; then
      die "approve is for the person at a terminal (stdin and stdout must be a TTY). Run it yourself: agent-terminal-proposals approve ${1:-<id>}"
    fi
    [ $# -ge 1 ] || die "usage: agent-terminal-proposals approve <id>" 64
    check_id "$1"; root_or_none decide; open_file
    kind=$(proposal_get "$FILE" kind)
    case "$kind" in
      rule)
        patched_copy "$FILE"
        if [ "$TEST_MODE" -eq 1 ] && ! under_sandbox "$REAL"; then die "AGENT_TERMINAL_TEST: the target $REAL is outside the test sandbox; not approving" 3; fi
        target=$(proposal_get "$FILE" target)
        printf '%s\n\n' "$(proposal_section "$FILE" proposal)"
        show_diff "$target"
        confirm "Apply this change to $REAL?" || { echo; echo "not applied; nothing changed"; exit 1; } ;;
      *)
        printf '%s %s:\n\n%s\n' "$kind" "$ID" "$(proposal_section "$FILE" proposal)"
        confirm "Approve $ID?" || { echo; echo "not approved; nothing changed"; exit 1; } ;;
    esac
    case "$kind" in
      rule)
        bak=$(proposal_safe_path "archive/$ID.target-before") || die "cannot use $ROOT/archive" 3
        if [ -e "$bak" ]; then bak=$(proposal_safe_path "archive/$ID.$(date -u +%Y%m%dT%H%M%SZ).target-before") || die "cannot use $ROOT/archive" 3; fi
        cp "$REAL" "$bak" && chmod 600 "$bak"
        tmp="${REAL%/*}/.${REAL##*/}.agent-terminal.$$"
        cp -p "$REAL" "$tmp" && cat "$NEW" >"$tmp" && mv -f "$tmp" "$REAL" || { rm -f "$tmp"; die "could not write $REAL (the old version is in $bak)"; }
        decide "$FILE" approved approved
        echo "applied to $REAL. The old version is in $bak; the proposal is in $DECIDED." ;;
      skill)
        decide "$FILE" approved approved
        name=$(proposal_get "$DECIDED" target)
        cat <<EOT
Approved. Nothing was written to ~/.claude/skills. To build the skill, start a Claude Code session and give it this prompt:

Use the skill-creator skill to create a new skill named "$name". The approved proposal from Agent Terminal's learner, with the evidence it was based on, is in $DECIDED. Read that file first, keep the skill as small as the evidence supports, and check that no installed skill already does this before you write anything.
EOT
        ;;
      lesson)
        lf="$AGENT_HOME/profile/lessons.jsonl"
        ( umask 077; mkdir -p "$AGENT_HOME/profile" )
        line=$(jq -nc --arg id "$ID" --arg fp "$(proposal_get "$FILE" fingerprint)" --arg text "$(proposal_section "$FILE" proposal)" \
          --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{id: $id, fingerprint: $fp, text: $text, approved: $ts}')
        ( umask 077; printf '%s\n' "$line" >>"$lf" )
        decide "$FILE" approved approved
        echo "approved; appended to $lf. The proposal is in $DECIDED." ;;
      *)
        decide "$FILE" approved approved
        echo "approved (a $kind has nothing to apply). The proposal is in $DECIDED." ;;
    esac
    exit 0 ;;

  reject)
    [ $# -ge 1 ] || die "usage: agent-terminal-proposals reject <id> [reason]" 64
    check_id "$1"; shift; root_or_none decide; open_file
    fp=$(proposal_get "$FILE" fingerprint)
    [[ "$fp" =~ ^[0-9a-f]{40}$ ]] || die "$FILE has no valid fingerprint; move it away by hand"
    reason=$(printf '%s' "$*" | tr '\r\n\t' '   ' | cut -c1-200)
    rj=$(proposal_safe_path rejected.txt) || die "cannot use $ROOT/rejected.txt" 3
    ( umask 077; printf '%s%s\n' "$fp" "${reason:+ $reason}" >>"$rj" )
    decide "$FILE" rejected rejected
    echo "rejected $ID: it will not be proposed again (fingerprint in $rj). The proposal is in $DECIDED." ;;

  snooze)
    [ $# -ge 2 ] || die "usage: agent-terminal-proposals snooze <id> <days>" 64
    check_id "$1"
    [[ "$2" =~ ^[1-9][0-9]{0,3}$ ]] || die "days must be a whole number from 1 to 9999" 2
    root_or_none decide; open_file
    until=$(date -v+"$2"d +%Y-%m-%d 2>/dev/null || date -d "+$2 days" +%Y-%m-%d)
    decide "$FILE" "snoozed:$until" snoozed
    echo "snoozed $ID until $until. The learner may propose it again after that. The proposal is in $DECIDED." ;;

  -h|--help|help) usage; exit 0 ;;
  "") usage; exit 64 ;;
  *) echo "agent-terminal-proposals: unknown command '$cmd'" >&2; usage >&2; exit 64 ;;
esac
