#!/usr/bin/env bash
# ching pre-push hook: second layer behind guard.sh (PreToolUse). It sees the RESOLVED refs git is about
# to push, so shell obfuscation in the command line cannot hide a push to a protected branch.
# While the push gate is on (push_gate=on in $AGENT_HOME/config, default ~/.agent/config; OFF by default), a push to
# a protected branch is allowed only with a valid release token for the exact commit pushed. With the gate off a push
# needs no token; deleting a protected branch is never allowed. The switch is read through $CHING_BIN/lib.sh
# (push_gate_on); a lib.sh or a config that cannot be read means off. A copy of this hook that is already installed
# does not change: run install.sh --install-prepush <repo> again to update it.
# Humans can bypass with `git push --no-verify`; guard.sh denies --no-verify for agents.
# Installed by: install.sh --install-prepush <repo>
# ching-prepush-marker
set -euo pipefail
CHING_BIN="@CHING_BIN@"
PROTECTED="${GUARD_PROTECTED_BRANCHES:-main master}"
DEFAULT=$(git symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)
ZERO=0000000000000000000000000000000000000000
status=0
gate=""
gate_on() { # read once, and only when a protected branch is pushed
  if [ -z "$gate" ]; then
    # shellcheck source=/dev/null
    if [ -r "$CHING_BIN/lib.sh" ] && ( . "$CHING_BIN/lib.sh" && push_gate_on ) >/dev/null 2>&1; then gate=1; else gate=0; fi
  fi
  [ "$gate" = 1 ]
}
while read -r lref lsha rref rsha; do
  : "$lref" "$rsha"
  branch=${rref#refs/heads/}
  [ "$branch" != "$rref" ] || continue
  protected=0
  for p in $PROTECTED $DEFAULT; do [ "$branch" != "$p" ] || protected=1; done
  [ "$protected" -eq 1 ] || continue
  if [ "$lsha" = "$ZERO" ]; then
    echo "pre-push: deleting protected branch $branch is not allowed" >&2; status=1; continue
  fi
  gate_on || continue
  if ! msg=$("$CHING_BIN/release-gate.sh" --verify "$lsha" 2>&1); then
    echo "pre-push: push to $branch blocked: $msg" >&2
    echo "pre-push: run release-gate.sh (and, in confirm mode, release-gate.sh --approve) first." >&2
    status=1
  fi
done
exit "$status"
