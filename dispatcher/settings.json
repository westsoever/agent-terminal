{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "ListAgents",
      "SendMessage",
      "ToolSearch",
      "mcp__voicemode__converse",
      "mcp__plugin_voicemode_voicemode__converse",
      "Bash(~/.claude/kaching/bin/dash.sh:*)",
      "Bash(@KACHING@/bin/dash.sh:*)",
      "Bash(~/.claude/kaching/dispatcher/relay-log.sh:*)",
      "Bash(@KACHING@/dispatcher/relay-log.sh:*)",
      "Read(//**/.agent/STATE.md)",
      "Read(//**/.agent/NEXT.md)",
      "Read(//**/sessions/*/STATE.md)",
      "Read(//**/sessions/*/NEXT.md)"
    ],
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "Monitor"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {"type": "command", "command": "@KACHING@/dispatcher/tool-gate.sh", "timeout": 10}
        ]
      }
    ]
  }
}
